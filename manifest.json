{
  "manifest_version": 3,
  "name": "LinkedIn Search Scraper",
  "version": "0.1.0",
  "description": "Scrape LinkedIn people-search results from a filter URL and export them as JSON.",

  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting",
    "cookies"
  ],

  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://linkedin.com/*"
  ],

  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*",
        "https://linkedin.com/*"
      ],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_title": "Open LinkedIn Search Scraper",
    "default_icon": {
      "16": "public/icons/icon16.png",
      "48": "public/icons/icon48.png",
      "128": "public/icons/icon128.png"
    }
  },

  "icons": {
    "16": "public/icons/icon16.png",
    "48": "public/icons/icon48.png",
    "128": "public/icons/icon128.png"
  }
}
